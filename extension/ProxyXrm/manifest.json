{
    "manifest_version": 3,
    "name": "RickSrick - Xrm Proxy",
    "version": "0.1",
    "description": "This extension provide a Proxy to use Xrm object in localhost.",
    "action": {
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        },
        "default_popup": "popup.html"
    },
    "permissions": [
        "scripting",
        "activeTab",
        "tabs",
        "storage"
    ],
    "host_permissions": [
        "https://*.dynamics.com/*",
        "https://*.powerapps.com/*"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "background": {
        "service_worker": "scripts/background.js"
    },
    "content_security_policy": {
        "script-src": "'self'; object-src 'self'"
    },
    "content_scripts": [
        {
            "matches": ["http://localhost/*"],
            "js": ["scripts/core.js"],
            "world": "MAIN"
        },
        {
            "matches": ["http://localhost/*"],
            "js": ["scripts/relay.js"]
        }
    ]
}